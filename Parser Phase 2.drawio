  <diagram name="Page-1" id="rdparser-phase2">
    <mxGraphModel dx="936" dy="569" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rd-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 22px;&quot;&gt;&lt;b&gt;Recursive Descent Parser&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="1260" x="40" y="20" as="geometry" />
        </mxCell>
        <mxCell id="rd-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Each nonterminal in our grammar is a function. The function looks at the current token (inp) and picks the production whose selection set has that token. The ε productions only return if inp is in the follow set, otherwise reject. The call stack works like the stack of a pushdown machine." vertex="1">
          <mxGeometry height="44" width="1260" x="40" y="64" as="geometry" />
        </mxCell>
        <mxCell id="rd-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;div&gt;&lt;b&gt;Machine&lt;/b&gt;&lt;/div&gt;&lt;div&gt;inp = the current token from our scanner&lt;/div&gt;&lt;div&gt;getInp(): inp = next token (↵ at the end)&lt;/div&gt;&lt;div&gt;match(t): if inp == t then getInp() else reject()&lt;/div&gt;&lt;div&gt;accept(): print Accept and stop&lt;/div&gt;&lt;div&gt;reject(): print Reject and stop&lt;/div&gt;" vertex="1">
          <mxGeometry height="122" width="440" x="30" y="130" as="geometry" />
        </mxCell>
        <mxCell id="rd-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;Statements&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="380" x="40" y="270" as="geometry" />
        </mxCell>
        <mxCell id="rd-6" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;div&gt;&lt;b&gt;main()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;getInp()&lt;/div&gt;&lt;div&gt;Program()&lt;/div&gt;&lt;div&gt;if inp == ↵ then accept()&lt;/div&gt;&lt;div&gt;else reject()&lt;/div&gt;" vertex="1">
          <mxGeometry height="104" width="380" x="40" y="306" as="geometry" />
        </mxCell>
        <mxCell id="rd-7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;div&gt;&lt;b&gt;Program()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;StmtList()&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="380" x="40" y="440" as="geometry" />
        </mxCell>
        <mxCell id="rd-8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;div&gt;&lt;b&gt;StmtList()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;if inp ∈ {int, float, identifier, if, while, for, {}&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Stmt()&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;StmtList()&lt;/div&gt;&lt;div&gt;else if inp ∈ { }, ↵ }&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;return&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; // ε&lt;/div&gt;&lt;div&gt;else reject()&lt;/div&gt;" vertex="1">
          <mxGeometry height="140" width="380" x="40" y="520" as="geometry" />
        </mxCell>
        <mxCell id="rd-9" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;div&gt;&lt;b&gt;Stmt()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;if inp ∈ {int, float}&amp;nbsp;&amp;nbsp;Declaration()&lt;/div&gt;&lt;div&gt;else if inp == identifier&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Assignment()&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;match(;)&lt;/div&gt;&lt;div&gt;else if inp == if&amp;nbsp;&amp;nbsp;IfStmt()&lt;/div&gt;&lt;div&gt;else if inp == while&amp;nbsp;&amp;nbsp;WhileStmt()&lt;/div&gt;&lt;div&gt;else if inp == for&amp;nbsp;&amp;nbsp;ForStmt()&lt;/div&gt;&lt;div&gt;else if inp == {&amp;nbsp;&amp;nbsp;Block()&lt;/div&gt;&lt;div&gt;else reject()&lt;/div&gt;" vertex="1">
          <mxGeometry height="194" width="380" x="40" y="690" as="geometry" />
        </mxCell>
        <mxCell id="rd-10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;div&gt;&lt;b&gt;Declaration()&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Type()&lt;/div&gt;&lt;div&gt;match(identifier)&lt;/div&gt;&lt;div&gt;Init()&lt;/div&gt;&lt;div&gt;match(;)&lt;/div&gt;" vertex="1">
